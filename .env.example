# Society Complaint Triage - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Frontend API URL (Used by client Vite app)
VITE_API_URL=http://localhost:5000/api

# Supabase PostgreSQL Configuration
# (If left empty, the server automatically uses a realistic in-memory database with demo seed data)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Triage & LLM Configuration (For Phase 2)
AI_API_KEY=your-gemini-or-openai-api-key
AI_MODEL=gemini-1.5-flash
